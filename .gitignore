# =================================================
# 550W 项目全局屏蔽名单：除了代码，什么都别想进来
# =================================================

# 1. 屏蔽所有虚拟环境（不管是 venv 还是 Conda）
**/venv/
**/.venv/
**/env/
**/ENV/
**/conda/
bin/
lib/
include/
share/

# 2. 屏蔽 Python 运行产生的垃圾缓存
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
.mypy_cache/

# 3. 屏蔽物理数据和模型资产。
# 不允许使用 **/models/：adcust_logic/models 是必须提交的 Python 领域模型源码。
**/datasets/
**/checkpoints/
**/storage/adapters/
**/storage/models/
**/model-cache/
**/model_cache/
# 所有 data 目录都是本地持久化或运行时数据，不允许提交到 Git。
**/data/
*.bin
*.safetensors
*.pt
*.pth
*.zip
*.tar.gz
*.7z
*.onnx

# 4. 屏蔽 IDE 和系统产生的配置文件
.idea/
.vscode/
*.swp
*.bak
.DS_Store
Thumbs.db

# 5. 屏蔽前端/构建产生的冗余
node_modules/
dist/
build/
out/




# 6. 屏蔽打包与分发的元数据
*.egg-info/
.installed.cfg
*.egg
