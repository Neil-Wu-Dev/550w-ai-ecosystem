# =================================================
# 550W 项目全局屏蔽名单：除了代码，什么都别想进来
# =================================================

# 1. 屏蔽所有虚拟环境（不管是 venv 还是 Conda）
**/venv/
**/.venv/
**/env/
**/ENV/
**/conda/
.env
.env.*
!.env.example
bin/
lib/
include/
share/

# 2. 屏蔽 Python 运行产生的垃圾缓存
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
.mypy_cache/
*.log
*.tmp
*.temp

# 3. 屏蔽物理数据和模型资产。
# 不允许使用 **/models/：adcust_logic/models 是必须提交的 Python 领域模型源码。
**/datasets/
**/checkpoints/
**/storage/adapters/
**/storage/models/
**/model-cache/
**/model_cache/
# 所有 data 目录都是本地持久化或运行时数据，不允许提交到 Git。
**/data/
*.bin
*.safetensors
*.pt
*.pth
*.zip
*.tar.gz
*.7z
*.onnx

# 4. 屏蔽仓库根目录的个人 IDE 配置；项目内已跟踪的运行配置不受影响。
/.idea/
/.vscode/
/.run/
*.swp
*.bak
.DS_Store
Thumbs.db

# 5. 屏蔽前端/构建产生的冗余
node_modules/
dist/
build/
.build/
out/
.pnpm-store/
**/target/




# 6. 屏蔽打包与分发的元数据
*.egg-info/
.installed.cfg
*.egg

# 7. 本地 release 产物。正式二进制包不进 Git；应上传到 GitHub Releases。
release/adcust/**/*.exe
release/adcust/**/runtime/
release/adcust/**/data/
release/adcust/**/logs/
release/adcust/**/release-manifest.json
release/adcust/**/*.msi
release/adcust/**/*.nsis.zip
apps/adcust-launcher/target/
